{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^.*\\.(csproj|props)$/"
      ],
      "matchStrings": [
        "<TargetFramework>net(?<currentValue>.+)</TargetFramework>"
      ],
      "depNameTemplate": "dotnet-targetframework",
      "datasourceTemplate": "docker",
      "packageNameTemplate": "mcr.microsoft.com/dotnet/runtime",
      "versioningTemplate": "dotnet"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "dotnet-targetframework",
        "mcr.microsoft.com/dotnet/*"
      ],
      "groupName": ".NET version",
      "groupSlug": "dotnet-version"
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchPackageNames": [
        "Microsoft.EntityFrameworkCore.*",
        "Microsoft.AspNetCore.*",
        "Microsoft.Extensions.ApiDescription.Server",
        "Microsoft.OpenApi",
        "dotnet-ef"
      ],
      "groupName": ".NET framework packages"
    }
  ]
}
