{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "mergeConfidence:all-badges"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "other dependencies"
    },
    {
      "matchManagers": ["bun"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm packages"
    },
    {
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": ".NET packages"
    },
    {
      "matchPackageNames": ["mcr.microsoft.com/dotnet/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": ".NET packages"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchDepNames": ["bun"],
      "groupName": "npm packages"
    },
    {
      "matchPackageNames": ["vite-plus", "vite", "vitest", "@vitest/**", "@voidzero-dev/**"],
      "groupName": "Vite+",
      "dependencyDashboardApproval": true
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["bun"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["bun"],
      "addLabels": ["JS"]
    },
    {
      "matchManagers": ["nuget"],
      "addLabels": [".NET"]
    },
    {
      "matchManagers": ["dockerfile", "docker-compose", "devcontainer"],
      "addLabels": ["Docker"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["GitHub Actions"]
    },
    {
      "matchPackageNames": ["mcr.microsoft.com/mssql/server"],
      "versioning": "regex:^(?<major>\\d+)-CU(?<minor>\\d+)(-GDR(?<patch>\\d+))?-(?<compatibility>.+)$",
      "allowedVersions": "/^2022-/",
      "groupName": "SQL Server"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^backend/.+\\.cs$/"],
      "matchStrings": ["\"(?<depName>mcr\\.microsoft\\.com/mssql/server):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\""],
      "datasourceTemplate": "docker"
    }
  ],
  "labels": ["dependencies"],
  "prHourlyLimit": 15
}
