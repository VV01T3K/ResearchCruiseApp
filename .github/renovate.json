{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "mergeConfidence:all-badges"],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "other dependencies"
    },
    {
      "matchManagers": ["bun"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm packages"
    },
    {
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": ".NET packages"
    },
    {
      "matchPackageNames": ["mcr.microsoft.com/dotnet/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": ".NET packages"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchDepNames": ["bun"],
      "groupName": "npm packages"
    },
    {
      "matchPackageNames": ["vite-plus", "vite", "vitest", "@vitest/**", "@voidzero-dev/**"],
      "groupName": "Vite+",
      "dependencyDashboardApproval": true
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": ["mcr.microsoft.com/**"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "matchManagers": ["bun"],
      "addLabels": ["JS"]
    },
    {
      "matchManagers": ["nuget"],
      "addLabels": [".NET"]
    },
    {
      "matchManagers": ["dockerfile", "docker-compose", "devcontainer"],
      "addLabels": ["Docker"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["GitHub Actions"]
    },
    {
      "matchPackageNames": ["mcr.microsoft.com/mssql/server"],
      "versioning": "regex:^(?<major>\\d+)-CU(?<minor>\\d+)(-GDR(?<patch>\\d+))?-(?<compatibility>.+)$",
      "allowedVersions": "/^2022-/",
      "groupName": "SQL Server"
    },
    {
      "matchPackageNames": ["dotnet-sdk", "mcr.microsoft.com/dotnet/**"],
      "allowedVersions": "/^10\\./"
    },
    {
      "matchPackageNames": [
        "dotnet-ef",
        "Microsoft.AspNetCore.*",
        "Microsoft.EntityFrameworkCore.*",
        "Microsoft.Extensions.ApiDescription.Server",
        "System.Security.Cryptography.Pkcs"
      ],
      "allowedVersions": "<11.0.0"
    },
    {
      "matchPackageNames": ["Microsoft.OpenApi"],
      "allowedVersions": "<3.0.0"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^backend/.+\\.cs$/"],
      "matchStrings": ["\"(?<depName>mcr\\.microsoft\\.com/mssql/server):(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "docker"
    }
  ],
  "labels": ["dependencies"],
  "prHourlyLimit": 15
}
