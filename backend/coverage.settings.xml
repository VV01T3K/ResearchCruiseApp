<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[/\\]ResearchCruiseApp\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Sources>
      <Exclude>
        <Source>.*[/\\]Infrastructure[/\\]Persistence[/\\]Migrations[/\\].*</Source>
        <Source>.*[/\\]Resources[/\\].*\.Designer\.cs$</Source>
        <Source>.*[/\\]App_GlobalResources[/\\].*\.Designer\.cs$</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
