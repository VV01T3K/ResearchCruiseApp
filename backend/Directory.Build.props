<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAuditLevel>high</NuGetAuditLevel>
    <!-- Fail CI on high/critical vulnerabilities or an unavailable audit source. -->
    <WarningsAsErrors Condition="'$(CI)' == 'true'"
      >$(WarningsAsErrors);NU1900;NU1903;NU1904;NU1905</WarningsAsErrors
    >
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
