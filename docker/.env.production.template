# Release tag to deploy
APP_VERSION=v3.0.0

FRONTEND_URL=https://rejsy.ug.edu.pl

# Keep the values currently used in production
DB_CONNECTION_STRING=Server=host.docker.internal,1433;Database=ResearchCruiseApp;User Id=<user>;Password=<password>;Encrypt=False

# true for the first start of a new release, then false
DATABASE_APPLY_MIGRATIONS=true

# Generate once with: openssl rand -base64 48 (changing it signs out all users)
JWT_SECRET=

SMTP_USERNAME=
SMTP_PASSWORD=

# DSNs of the production Sentry projects; empty disables reporting
SENTRY_DSN_FRONTEND=
SENTRY_DSN_BACKEND=
SENTRY_TRACES_SAMPLE_RATE=1
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=1
