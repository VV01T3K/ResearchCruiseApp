{
  "name": "frontend",
  "version": "3.0.0",
  "private": true,
  "repository": "https://github.com/VV01T3K/ResearchCruiseApp",
  "type": "module",
  "scripts": {
    "dev": "vp dev --host",
    "build": "tsgo && vp build",
    "type": "tsgo",
    "check": "vp check",
    "lint:design": "oxlint -c .oxlintrc.design.json src stories",
    "lint:design:audit": "oxlint -c .oxlintrc.design.audit.json src stories",
    "fix": "vp check --fix",
    "gen": "orval -c orval.config.ts",
    "preview": "vp preview --host",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vp run test:unit && vp run test:storybook && vp run test:browser",
    "test:unit": "vp test run --project unit",
    "test:storybook": "vp test run --project storybook",
    "test:browser": "playwright test",
    "test:ui": "playwright test --ui",
    "lint": "vp check && vp run type"
  },
